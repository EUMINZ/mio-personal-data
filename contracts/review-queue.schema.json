{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mio.local/contracts/review-queue.schema.json",
  "title": "Mio Pending Review Queue",
  "description": "Structured pending review queue exported from mio-core for downstream review shells.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "person",
    "bundles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mio.review.queue.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundleId",
          "sourceSystem",
          "status",
          "createdAt",
          "updatedAt",
          "requestedFields",
          "injectedFields",
          "pageProfile",
          "tripRecord",
          "pendingItemCount",
          "items"
        ],
        "properties": {
          "bundleId": {
            "type": "string"
          },
          "sourceBundleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceSystem": {
            "type": "string"
          },
          "producer": {
            "type": [
              "string",
              "null"
            ]
          },
          "stageKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "stageLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "requestedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "injectedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pageProfile": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tripRecord": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object"
          },
          "source": {
            "type": "object"
          },
          "pendingItemCount": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemId",
                "itemType",
                "field",
                "target",
                "suggestedValue",
                "currentValue",
                "rationale",
                "sourceDocumentIds",
                "supportingEvidenceIds",
                "status",
                "createdAt"
              ],
              "properties": {
                "itemId": {
                  "type": "string"
                },
                "itemType": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "suggestedValue": {
                  "type": "string"
                },
                "currentValue": {
                  "type": "string"
                },
                "rationale": {
                  "type": "string"
                },
                "sourceDocumentIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "supportingEvidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "relatedMemory": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/memoryItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "memoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "snippetText",
        "rationale",
        "sourceKind",
        "sourceRef",
        "sourceLocator",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "snippetText": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string"
        },
        "sourceRef": {
          "type": "string"
        },
        "sourceLocator": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "serviceKey": {
          "type": "string"
        },
        "sessionOrBundleId": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
